<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**\*</DefaultItemExcludes>
    <RepositoryCommit Condition="'$(RepositoryCommit)' == '' and '$(GITHUB_SHA)' != ''">$(GITHUB_SHA)</RepositoryCommit>
    <RepositoryCommit Condition="'$(RepositoryCommit)' == '' and '$(BUILD_COMMIT)' != ''">$(BUILD_COMMIT)</RepositoryCommit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

  <Target Name="BuildTailwindCss"
          BeforeTargets="Build"
      Condition="'$(Configuration)' == 'Debug' and '$(DesignTimeBuild)' != 'true' and '$(ContinuousIntegrationBuild)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="npm run build:css" />
  </Target>

  <Target Name="ResolveRepositoryCommit" BeforeTargets="CoreCompile">
    <Exec Command="git rev-parse HEAD"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMsBuild="true"
          StandardOutputImportance="Low"
          IgnoreExitCode="true"
          Condition="'$(RepositoryCommit)' == ''">
      <Output TaskParameter="ConsoleOutput" PropertyName="RepositoryCommit" />
    </Exec>
    <ItemGroup Condition="'$(RepositoryCommit)' != ''">
      <_RepositoryCommitAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>RepositoryCommit</_Parameter1>
        <_Parameter2>$(RepositoryCommit)</_Parameter2>
      </_RepositoryCommitAttribute>
    </ItemGroup>
    <WriteCodeFragment Language="C#"
                       OutputFile="$(IntermediateOutputPath)RepositoryCommit.AssemblyInfo.cs"
                       AssemblyAttributes="@(_RepositoryCommitAttribute)"
                       Condition="'$(RepositoryCommit)' != ''">
      <Output TaskParameter="OutputFile" ItemName="Compile" />
    </WriteCodeFragment>
  </Target>

</Project>
