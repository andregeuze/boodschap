@page "/Error"
@using System.Diagnostics
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["Error.PageTitle"]</PageTitle>

<h1 class="text-danger">@Localizer["Error.Title"]</h1>
<h2 class="text-danger">@Localizer["Error.Message"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@Localizer["Error.RequestId"]</strong> <code>@RequestId</code>
    </p>
}

<h3>@Localizer["Error.DevelopmentMode"]</h3>
<p>
    @Localizer["Error.DevelopmentModeDescription"]
</p>
<p>
    <strong>@Localizer["Error.DevelopmentEnvironmentWarning"]</strong>
    @Localizer["Error.DevelopmentModeInstructions"]
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
