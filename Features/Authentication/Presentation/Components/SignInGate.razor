@inject NavigationManager Navigation
@using Boodschap.Features.Authentication.Application
@inject ILocalAuthenticationService LocalAuthentication

<div class="mx-auto flex min-h-screen w-full max-w-lg items-center justify-center px-4 py-10">
	<div class="w-full rounded-[2rem] border border-neutral-200 bg-white p-8 text-neutral-900 shadow-2xl shadow-black/10 dark:border-white/10 dark:bg-neutral-950/90 dark:text-neutral-100 dark:shadow-black/20">
		<p class="text-xs font-medium uppercase tracking-[0.24em] text-emerald-600 dark:text-emerald-400">Account access</p>
		<h1 class="mt-3 text-3xl font-black tracking-tight text-neutral-950 dark:text-white">@Title</h1>
		<p class="mt-3 text-sm leading-6 text-neutral-600 dark:text-neutral-400">@Description</p>

		@if (ErrorMessage is not null)
		{
			<div class="mt-6 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-4 text-sm leading-6 text-rose-800 dark:border-rose-500/20 dark:bg-rose-500/10 dark:text-rose-200">
				@ErrorMessage
			</div>
		}

		<div class="mt-6 grid gap-4">
			<form method="post" action="/account/login" class="rounded-2xl border border-neutral-200 bg-neutral-50 p-5 dark:border-white/10 dark:bg-white/5">
				<AntiforgeryToken />
				<input type="hidden" name="returnUrl" value="@NormalizedReturnUrl" />
				<h2 class="text-lg font-semibold text-neutral-950 dark:text-white">Sign in</h2>
				<p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">Use your Boodschap username and password.</p>

				<div class="mt-4 space-y-4">
					<div class="space-y-1">
						<label class="text-sm font-medium text-neutral-700 dark:text-neutral-300" for="login-username">Username</label>
						<input id="login-username"
							   name="username"
							   autocomplete="username"
							   class="w-full rounded-2xl border border-neutral-200 bg-white px-3 py-2 text-sm text-neutral-900 outline-none ring-emerald-500/30 placeholder:text-neutral-400 focus:ring-2 dark:border-white/10 dark:bg-white/5 dark:text-white dark:ring-emerald-400/40 dark:placeholder:text-neutral-500"
							   value="@SuggestedUsername" />
					</div>
					<div class="space-y-1">
						<label class="text-sm font-medium text-neutral-700 dark:text-neutral-300" for="login-password">Password</label>
						<input id="login-password"
							   name="password"
							   type="password"
							   autocomplete="current-password"
							   class="w-full rounded-2xl border border-neutral-200 bg-white px-3 py-2 text-sm text-neutral-900 outline-none ring-emerald-500/30 placeholder:text-neutral-400 focus:ring-2 dark:border-white/10 dark:bg-white/5 dark:text-white dark:ring-emerald-400/40 dark:placeholder:text-neutral-500" />
					</div>
				</div>

				<button type="submit" class="mt-5 rounded-full bg-emerald-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-400 dark:bg-emerald-400 dark:text-neutral-950 dark:hover:bg-emerald-300">
					Sign in
				</button>
			</form>

			@if (isBootstrapRegistrationOpen)
			{
				<form method="post" action="/account/register" class="rounded-2xl border border-neutral-200 bg-neutral-50 p-5 dark:border-white/10 dark:bg-white/5">
					<AntiforgeryToken />
					<input type="hidden" name="returnUrl" value="@NormalizedReturnUrl" />
					<h2 class="text-lg font-semibold text-neutral-950 dark:text-white">Create the first account</h2>
					<p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">The first account becomes the administrator and can create additional users later.</p>

					<div class="mt-4 space-y-4">
						<div class="space-y-1">
							<label class="text-sm font-medium text-neutral-700 dark:text-neutral-300" for="register-username">Username</label>
							<input id="register-username"
								   name="username"
								   autocomplete="username"
								   class="w-full rounded-2xl border border-neutral-200 bg-white px-3 py-2 text-sm text-neutral-900 outline-none ring-emerald-500/30 placeholder:text-neutral-400 focus:ring-2 dark:border-white/10 dark:bg-white/5 dark:text-white dark:ring-emerald-400/40 dark:placeholder:text-neutral-500"
								   value="@SuggestedUsername" />
						</div>
						<div class="space-y-1">
							<label class="text-sm font-medium text-neutral-700 dark:text-neutral-300" for="register-password">Password</label>
							<input id="register-password"
								   name="password"
								   type="password"
								   autocomplete="new-password"
								   class="w-full rounded-2xl border border-neutral-200 bg-white px-3 py-2 text-sm text-neutral-900 outline-none ring-emerald-500/30 placeholder:text-neutral-400 focus:ring-2 dark:border-white/10 dark:bg-white/5 dark:text-white dark:ring-emerald-400/40 dark:placeholder:text-neutral-500" />
						</div>
						<div class="space-y-1">
							<label class="text-sm font-medium text-neutral-700 dark:text-neutral-300" for="register-confirm-password">Confirm password</label>
							<input id="register-confirm-password"
								   name="confirmPassword"
								   type="password"
								   autocomplete="new-password"
								   class="w-full rounded-2xl border border-neutral-200 bg-white px-3 py-2 text-sm text-neutral-900 outline-none ring-emerald-500/30 placeholder:text-neutral-400 focus:ring-2 dark:border-white/10 dark:bg-white/5 dark:text-white dark:ring-emerald-400/40 dark:placeholder:text-neutral-500" />
						</div>
					</div>

					<p class="mt-4 text-xs text-neutral-500 dark:text-neutral-500">Use at least 8 characters for the password.</p>

					<button type="submit" class="mt-5 rounded-full border border-neutral-200 bg-white px-4 py-2 text-sm font-medium text-neutral-800 transition hover:bg-neutral-50 dark:border-white/10 dark:bg-white/5 dark:text-neutral-100 dark:hover:bg-white/10">
						Create account
					</button>
				</form>
			}
			else
			{
				<div class="rounded-2xl border border-neutral-200 bg-neutral-50 p-5 text-sm leading-6 text-neutral-600 dark:border-white/10 dark:bg-white/5 dark:text-neutral-400">
					Self-service registration is closed. Ask an administrator to create an account for you.
				</div>
			}
		</div>
	</div>
</div>

@code {
	private bool isBootstrapRegistrationOpen;

	[Parameter]
	public string Title { get; set; } = "Sign in to continue.";

	[Parameter]
	public string Description { get; set; } = "Boodschap now requires a signed-in local account before the shared shopping lists can be used.";

	[Parameter]
	public string? ReturnUrl { get; set; }

	[Parameter]
	public string? ErrorCode { get; set; }

	[Parameter]
	public string? SuggestedUsername { get; set; }

	private string? ErrorMessage => ErrorCode switch
	{
		LocalAuthenticationErrorCodes.InvalidCredentials => "The username or password is incorrect.",
		LocalAuthenticationErrorCodes.AdminRequired => "Only an administrator can create new accounts.",
		LocalAuthenticationErrorCodes.BootstrapRegistrationClosed => "Self-service registration is closed. Ask an administrator to create an account for you.",
		LocalAuthenticationErrorCodes.UsernameRequired => "A username is required.",
		LocalAuthenticationErrorCodes.PasswordRequired => "A password is required.",
		LocalAuthenticationErrorCodes.PasswordTooShort => "Passwords must be at least 8 characters long.",
		LocalAuthenticationErrorCodes.PasswordMismatch => "The password confirmation does not match.",
		LocalAuthenticationErrorCodes.UsernameTaken => "That username is already in use.",
		_ => null
	};

	protected override async Task OnParametersSetAsync()
	{
		isBootstrapRegistrationOpen = await LocalAuthentication.IsBootstrapRegistrationOpenAsync();
	}

	private string NormalizedReturnUrl
	{
		get
		{
			if (!string.IsNullOrWhiteSpace(ReturnUrl))
			{
				return ReturnUrl;
			}

			var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
			if (string.IsNullOrWhiteSpace(relativePath))
			{
				return "/";
			}

			return relativePath.StartsWith('/') ? relativePath : $"/{relativePath}";
		}
	}
}