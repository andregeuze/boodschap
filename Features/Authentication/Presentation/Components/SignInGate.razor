@inject NavigationManager Navigation
@using Boodschap.Features.Authentication.Application
@inject ILocalAuthenticationService LocalAuthentication

<div class="mx-auto flex min-h-screen w-full max-w-lg items-center justify-center px-4 py-10">
	<div class="w-full rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
		<p class="text-xs font-medium uppercase tracking-[0.24em] text-slate-500">Account access</p>
		<h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-900">@Title</h1>
		<p class="mt-3 text-sm leading-6 text-slate-600">@Description</p>

		@if (ErrorMessage is not null)
		{
			<div class="mt-6 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-4 text-sm leading-6 text-rose-900">
				@ErrorMessage
			</div>
		}

		<div class="mt-6 grid gap-4">
			<form method="post" action="/account/login" class="rounded-2xl border border-slate-200 bg-slate-50 p-5">
				<AntiforgeryToken />
				<input type="hidden" name="returnUrl" value="@NormalizedReturnUrl" />
				<h2 class="text-lg font-semibold text-slate-900">Sign in</h2>
				<p class="mt-1 text-sm text-slate-600">Use your Boodschap username and password.</p>

				<div class="mt-4 space-y-4">
					<div class="space-y-1">
						<label class="text-sm font-medium text-slate-700" for="login-username">Username</label>
						<input id="login-username"
							   name="username"
							   autocomplete="username"
							   class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm outline-none ring-slate-300 placeholder:text-slate-400 focus:ring-2"
							   value="@SuggestedUsername" />
					</div>
					<div class="space-y-1">
						<label class="text-sm font-medium text-slate-700" for="login-password">Password</label>
						<input id="login-password"
							   name="password"
							   type="password"
							   autocomplete="current-password"
							   class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm outline-none ring-slate-300 placeholder:text-slate-400 focus:ring-2" />
					</div>
				</div>

				<button type="submit" class="mt-5 rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-slate-700">
					Sign in
				</button>
			</form>

			@if (isBootstrapRegistrationOpen)
			{
				<form method="post" action="/account/register" class="rounded-2xl border border-slate-200 bg-white p-5">
					<AntiforgeryToken />
					<input type="hidden" name="returnUrl" value="@NormalizedReturnUrl" />
					<h2 class="text-lg font-semibold text-slate-900">Create the first account</h2>
					<p class="mt-1 text-sm text-slate-600">The first account becomes the administrator and can create additional users later.</p>

					<div class="mt-4 space-y-4">
						<div class="space-y-1">
							<label class="text-sm font-medium text-slate-700" for="register-username">Username</label>
							<input id="register-username"
								   name="username"
								   autocomplete="username"
								   class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm outline-none ring-slate-300 placeholder:text-slate-400 focus:ring-2"
								   value="@SuggestedUsername" />
						</div>
						<div class="space-y-1">
							<label class="text-sm font-medium text-slate-700" for="register-password">Password</label>
							<input id="register-password"
								   name="password"
								   type="password"
								   autocomplete="new-password"
								   class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm outline-none ring-slate-300 placeholder:text-slate-400 focus:ring-2" />
						</div>
						<div class="space-y-1">
							<label class="text-sm font-medium text-slate-700" for="register-confirm-password">Confirm password</label>
							<input id="register-confirm-password"
								   name="confirmPassword"
								   type="password"
								   autocomplete="new-password"
								   class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm outline-none ring-slate-300 placeholder:text-slate-400 focus:ring-2" />
						</div>
					</div>

					<p class="mt-4 text-xs text-slate-500">Use at least 8 characters for the password.</p>

					<button type="submit" class="mt-5 rounded-md border border-slate-300 px-4 py-2 text-sm font-medium text-slate-800 transition hover:bg-slate-100">
						Create account
					</button>
				</form>
			}
			else
			{
				<div class="rounded-2xl border border-slate-200 bg-white p-5 text-sm leading-6 text-slate-600">
					Self-service registration is closed. Ask an administrator to create an account for you.
				</div>
			}
		</div>
	</div>
</div>

@code {
	private bool isBootstrapRegistrationOpen;

	[Parameter]
	public string Title { get; set; } = "Sign in to continue.";

	[Parameter]
	public string Description { get; set; } = "Boodschap now requires a signed-in local account before the shared shopping lists can be used.";

	[Parameter]
	public string? ReturnUrl { get; set; }

	[Parameter]
	public string? ErrorCode { get; set; }

	[Parameter]
	public string? SuggestedUsername { get; set; }

	private string? ErrorMessage => ErrorCode switch
	{
		LocalAuthenticationErrorCodes.InvalidCredentials => "The username or password is incorrect.",
		LocalAuthenticationErrorCodes.AdminRequired => "Only an administrator can create new accounts.",
		LocalAuthenticationErrorCodes.BootstrapRegistrationClosed => "Self-service registration is closed. Ask an administrator to create an account for you.",
		LocalAuthenticationErrorCodes.UsernameRequired => "A username is required.",
		LocalAuthenticationErrorCodes.PasswordRequired => "A password is required.",
		LocalAuthenticationErrorCodes.PasswordTooShort => "Passwords must be at least 8 characters long.",
		LocalAuthenticationErrorCodes.PasswordMismatch => "The password confirmation does not match.",
		LocalAuthenticationErrorCodes.UsernameTaken => "That username is already in use.",
		_ => null
	};

	protected override async Task OnParametersSetAsync()
	{
		isBootstrapRegistrationOpen = await LocalAuthentication.IsBootstrapRegistrationOpenAsync();
	}

	private string NormalizedReturnUrl
	{
		get
		{
			if (!string.IsNullOrWhiteSpace(ReturnUrl))
			{
				return ReturnUrl;
			}

			var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
			if (string.IsNullOrWhiteSpace(relativePath))
			{
				return "/";
			}

			return relativePath.StartsWith('/') ? relativePath : $"/{relativePath}";
		}
	}
}