@page "/account"
@using Boodschap.Features.Updates
@using Boodschap.Features.Updates.Presentation.Components
@using Microsoft.Extensions.Options
@attribute [Authorize]
@rendermode InteractiveServer
@inject ICurrentUserAccessor CurrentUserAccessor
@inject ILocalAuthenticationService LocalAuthentication
@inject IStringLocalizer<AppStrings> Localizer
@inject IOptions<UpdateFeatureOptions> UpdateFeatureOptions

<PageTitle>@Localizer["Account.PageTitle"]</PageTitle>

@if (currentUser is null)
{
	<div class="mx-auto flex min-h-screen w-full max-w-3xl items-center justify-center px-4 text-sm text-slate-500">
		@Localizer["Account.Loading"]
	</div>
}
else
{
	<div class="min-h-screen">
		<section class="mx-auto flex w-full max-w-5xl flex-col gap-6 px-4 py-8 sm:px-6">
			<div class="rounded-[2rem] border border-white/10 bg-gradient-to-br from-neutral-950 via-neutral-900 to-neutral-800 p-6 shadow-2xl shadow-black/20 text-neutral-100">
				<p class="text-sm font-medium uppercase tracking-[0.24em] text-emerald-400">@Localizer["Account.Title"]</p>
				<h1 class="mt-2 text-3xl font-black tracking-tight text-white">@currentUser.DisplayName</h1>
				<p class="mt-2 text-sm text-neutral-400">@Localizer["Account.ManageDescription"]</p>
			</div>

			<form class="rounded-[2rem] border border-white/10 bg-white/5 p-6 shadow-xl shadow-black/10" @onsubmit="ChangePassword">
				<h2 class="text-xl font-semibold text-white">@Localizer["Account.UpdatePassword"]</h2>
				<p class="mt-1 text-sm text-neutral-400">@Localizer["Account.UpdatePasswordDescription"]</p>

				@if (!string.IsNullOrWhiteSpace(passwordStatusMessage))
				{
					<div class="mt-4 rounded-2xl px-4 py-3 text-sm @(passwordStatusIsError ? "border border-rose-500/20 bg-rose-500/10 text-rose-200" : "border border-emerald-500/20 bg-emerald-500/10 text-emerald-200")">
						@passwordStatusMessage
					</div>
				}

				<div class="mt-4 space-y-4">
					<div class="space-y-1">
						<label class="text-sm font-medium text-neutral-300" for="current-password">@Localizer["Account.CurrentPassword"]</label>
						<input id="current-password"
							   class="w-full rounded-2xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white outline-none ring-emerald-400/40 placeholder:text-neutral-500 focus:ring-2"
							   type="password"
							   autocomplete="current-password"
							   @bind="currentPassword" />
					</div>
					<div class="space-y-1">
						<label class="text-sm font-medium text-neutral-300" for="new-password">@Localizer["Account.NewPassword"]</label>
						<input id="new-password"
							   class="w-full rounded-2xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white outline-none ring-emerald-400/40 placeholder:text-neutral-500 focus:ring-2"
							   type="password"
							   autocomplete="new-password"
							   @bind="newPassword" />
					</div>
					<div class="space-y-1">
						<label class="text-sm font-medium text-neutral-300" for="confirm-new-password">@Localizer["Account.ConfirmPassword"]</label>
						<input id="confirm-new-password"
							   class="w-full rounded-2xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white outline-none ring-emerald-400/40 placeholder:text-neutral-500 focus:ring-2"
							   type="password"
							   autocomplete="new-password"
							   @bind="confirmNewPassword" />
					</div>
				</div>

				<button type="submit" class="mt-5 rounded-full bg-emerald-400 px-4 py-2 text-sm font-semibold text-neutral-950 transition hover:bg-emerald-300">
					@Localizer["Account.UpdatePassword"]
				</button>
			</form>

			@if (currentUser.IsAdmin)
			{
				<form class="rounded-[2rem] border border-white/10 bg-white/5 p-6 shadow-xl shadow-black/10" @onsubmit="CreateUser">
					<h2 class="text-xl font-semibold text-white">@Localizer["Account.CreateUser"]</h2>
					<p class="mt-1 text-sm text-neutral-400">@Localizer["Account.CreateUserDescription"]</p>

					@if (!string.IsNullOrWhiteSpace(createUserStatusMessage))
					{
						<div class="mt-4 rounded-2xl px-4 py-3 text-sm @(createUserStatusIsError ? "border border-rose-500/20 bg-rose-500/10 text-rose-200" : "border border-emerald-500/20 bg-emerald-500/10 text-emerald-200")">
							@createUserStatusMessage
						</div>
					}

					<div class="mt-4 space-y-4">
						<div class="space-y-1">
							<label class="text-sm font-medium text-neutral-300" for="new-user-username">@Localizer["Account.Username"]</label>
							<input id="new-user-username"
								   class="w-full rounded-2xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white outline-none ring-emerald-400/40 placeholder:text-neutral-500 focus:ring-2"
								   autocomplete="username"
								   @bind="newUserUsername" />
						</div>
						<div class="space-y-1">
							<label class="text-sm font-medium text-neutral-300" for="new-user-password">@Localizer["Account.Password"]</label>
							<input id="new-user-password"
								   class="w-full rounded-2xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white outline-none ring-emerald-400/40 placeholder:text-neutral-500 focus:ring-2"
								   type="password"
								   autocomplete="new-password"
								   @bind="newUserPassword" />
						</div>
						<div class="space-y-1">
							<label class="text-sm font-medium text-neutral-300" for="new-user-confirm-password">@Localizer["Account.ConfirmPassword"]</label>
							<input id="new-user-confirm-password"
								   class="w-full rounded-2xl border border-white/10 bg-white/5 px-3 py-2 text-sm text-white outline-none ring-emerald-400/40 placeholder:text-neutral-500 focus:ring-2"
								   type="password"
								   autocomplete="new-password"
								   @bind="newUserConfirmPassword" />
						</div>
						<label class="flex items-center gap-2 text-sm text-neutral-300">
							<input type="checkbox" class="h-4 w-4 rounded border-white/20 accent-emerald-400" @bind="newUserIsAdmin" />
							@Localizer["Account.CreateAsAdmin"]
						</label>
					</div>

					<button type="submit" class="mt-5 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-neutral-100 transition hover:bg-white/10">
						@Localizer["Account.CreateUser"]
					</button>
				</form>
			}

			@if (UpdateFeatureOptions.Value.Enabled)
			{
				<UpdateStatus />
			}
		</section>
	</div>
}

@code {
	private CurrentUser? currentUser;
	private string currentPassword = string.Empty;
	private string newPassword = string.Empty;
	private string confirmNewPassword = string.Empty;
	private string passwordStatusMessage = string.Empty;
	private bool passwordStatusIsError;
	private string newUserUsername = string.Empty;
	private string newUserPassword = string.Empty;
	private string newUserConfirmPassword = string.Empty;
	private bool newUserIsAdmin;
	private string createUserStatusMessage = string.Empty;
	private bool createUserStatusIsError;

	protected override async Task OnInitializedAsync()
	{
		currentUser = await CurrentUserAccessor.GetRequiredCurrentUserAsync();
	}

	private async Task ChangePassword()
	{
		if (currentUser is null)
		{
			return;
		}

		var result = await LocalAuthentication.ChangePasswordAsync(currentUser.LocalUserId, currentPassword, newPassword, confirmNewPassword);
		passwordStatusIsError = !result.Succeeded;
		passwordStatusMessage = result.Succeeded
			? Localizer["Account.PasswordUpdated"].Value
			: DescribeError(result.ErrorCode);

		if (!result.Succeeded)
		{
			return;
		}

		currentPassword = string.Empty;
		newPassword = string.Empty;
		confirmNewPassword = string.Empty;
	}

	private async Task CreateUser()
	{
		if (currentUser is null)
		{
			return;
		}

		var result = await LocalAuthentication.CreateUserAsync(currentUser.LocalUserId, newUserUsername, newUserPassword, newUserConfirmPassword, newUserIsAdmin);
		createUserStatusIsError = !result.Succeeded;
		createUserStatusMessage = result.Succeeded
			? (newUserIsAdmin ? Localizer["Account.AdminAccountCreated"].Value : Localizer["Account.UserAccountCreated"].Value)
			: DescribeError(result.ErrorCode);

		if (!result.Succeeded)
		{
			return;
		}

		newUserUsername = string.Empty;
		newUserPassword = string.Empty;
		newUserConfirmPassword = string.Empty;
		newUserIsAdmin = false;
	}

	private string DescribeError(string? errorCode)
	{
		return errorCode switch
		{
			LocalAuthenticationErrorCodes.AdminRequired => Localizer["Account.Error.AdminRequired"].Value,
			LocalAuthenticationErrorCodes.BootstrapRegistrationClosed => Localizer["Account.Error.BootstrapRegistrationClosed"].Value,
			LocalAuthenticationErrorCodes.CurrentPasswordInvalid => Localizer["Account.Error.CurrentPasswordInvalid"].Value,
			LocalAuthenticationErrorCodes.CurrentPasswordRequired => Localizer["Account.Error.CurrentPasswordRequired"].Value,
			LocalAuthenticationErrorCodes.UsernameRequired => Localizer["Account.Error.UsernameRequired"].Value,
			LocalAuthenticationErrorCodes.PasswordRequired => Localizer["Account.Error.PasswordRequired"].Value,
			LocalAuthenticationErrorCodes.PasswordTooShort => Localizer["Account.Error.PasswordTooShort"].Value,
			LocalAuthenticationErrorCodes.PasswordMismatch => Localizer["Account.Error.PasswordMismatch"].Value,
			LocalAuthenticationErrorCodes.UsernameTaken => Localizer["Account.Error.UsernameTaken"].Value,
			_ => Localizer["Account.Error.RequestFailed"].Value
		};
	}
}