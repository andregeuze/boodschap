@page "/signed-out"
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["Account.SignedOutPageTitle"]</PageTitle>

<SignInGate Title="@Localizer["Account.SignedOutTitle"]"
			Description="@Localizer["Account.SignedOutDescription"]"
			ReturnUrl="/" />