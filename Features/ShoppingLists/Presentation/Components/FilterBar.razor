@rendermode InteractiveServer
@inject IStringLocalizer<AppStrings> Localizer

<TabBar Tabs="Filters"
		ActiveTab="@ActiveFilter"
		OnTabChanged="OnFilterChanged"
		AriaLabel="@Localizer["Shopping.FilterGroceries"]"
		TabLabelSelector="GetFilterLabel" />

@code {
	private static readonly IReadOnlyList<string> Filters = ShoppingItemFilters.AllValues;

	[Parameter, EditorRequired]
	public string ActiveFilter { get; set; } = ShoppingItemFilters.All;

	[Parameter, EditorRequired]
	public EventCallback<string> OnFilterChanged { get; set; }

	private string GetFilterLabel(string filter)
	{
		return filter switch
		{
			ShoppingItemFilters.All => Localizer["Shopping.FilterAll"].Value,
			ShoppingItemFilters.Needed => Localizer["Shopping.FilterNeeded"].Value,
			ShoppingItemFilters.Purchased => Localizer["Shopping.FilterPurchased"].Value,
			_ => filter
		};
	}
}