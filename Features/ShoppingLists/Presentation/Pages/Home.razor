@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@inject NavigationManager Navigation
@inject IShoppingListService ShoppingLists
@inject StoreChangeNotifier StoreChangeNotifier
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["Shopping.PageTitle"]</PageTitle>

<div class="min-h-screen">
	<section class="mx-auto flex w-full max-w-5xl flex-col gap-5 px-4 py-6 sm:px-6 sm:py-8">
		<div class="space-y-3">
			<p class="text-sm font-semibold uppercase tracking-[0.28em] text-emerald-600 dark:text-emerald-400">@Localizer["Shopping.HomeEyebrow"]</p>
			<div class="space-y-2">
				<h1 class="text-3xl font-black tracking-tight text-neutral-950 dark:text-white sm:text-4xl">@Localizer["Shopping.HomeHeading"]</h1>
				<p class="max-w-2xl text-sm leading-6 text-neutral-600 dark:text-neutral-300">@Localizer["Shopping.HomeDescription"]</p>
			</div>
		</div>

		<div class="space-y-4">
			<section class="overflow-hidden">
				@if (_isAddComposerOpen)
				{
					<div class="w-full rounded-[2rem] border border-neutral-200 bg-white p-4 shadow-[0_18px_50px_rgba(0,0,0,0.10)] transition duration-500 ease-out dark:border-white/10 dark:bg-neutral-900 sm:p-5 @(_isAddComposerEntering ? "translate-x-[110vw] opacity-0" : "translate-x-0 opacity-100")">
						<form class="flex flex-col gap-4 sm:min-h-24 sm:flex-row sm:items-center sm:justify-between"
						      @onsubmit="CreateList"
						      @onsubmit:preventDefault>
							<div class="flex min-w-0 flex-1 flex-col gap-3">
								<input id="new-list-name"
								       class="w-full border-0 border-b border-neutral-300 bg-transparent px-1 py-3 text-2xl font-light tracking-tight text-neutral-950 outline-none placeholder:text-neutral-300 focus:border-emerald-500 focus:ring-0 dark:border-white/15 dark:text-white dark:placeholder:text-neutral-600 dark:focus:border-emerald-400"
								       placeholder="@Localizer["Shopping.TitlePlaceholder"]"
								       @bind="newListName"
								       @bind:event="oninput"
								       autofocus />
								<input id="new-list-description"
								       class="w-full border-0 border-b border-neutral-200 bg-transparent px-1 py-2 text-sm text-neutral-700 outline-none placeholder:text-neutral-400 focus:border-emerald-500 focus:ring-0 dark:border-white/10 dark:text-neutral-300 dark:placeholder:text-neutral-600 dark:focus:border-emerald-400"
								       placeholder="@Localizer["Shopping.DescriptionPlaceholder"]"
								       @bind="newListDescription"
								       @bind:event="oninput" />
							</div>

							<div class="flex items-center justify-end gap-2 sm:shrink-0">
								<button type="button"
										class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-white text-rose-600 shadow-[0_12px_30px_rgba(244,63,94,0.14)] ring-1 ring-inset ring-neutral-200 transition hover:-translate-y-0.5 hover:bg-rose-50 hover:text-rose-500 hover:ring-rose-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-rose-400 dark:bg-white/10 dark:text-rose-300 dark:ring-white/15 dark:hover:bg-rose-400/10 dark:hover:text-rose-200 dark:hover:ring-rose-300/50"
										aria-label="@Localizer["Common.Cancel"]"
										@onclick="CancelAddComposer">
									<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
										<path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-linecap="round" stroke-width="2.25" />
									</svg>
								</button>
								<button type="submit"
										class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-white text-emerald-600 shadow-[0_12px_30px_rgba(16,185,129,0.18)] ring-1 ring-inset ring-neutral-200 transition hover:-translate-y-0.5 hover:bg-emerald-50 hover:text-emerald-500 hover:ring-emerald-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-400 disabled:cursor-not-allowed disabled:bg-neutral-100 disabled:text-neutral-300 disabled:shadow-none disabled:ring-neutral-200 dark:bg-white/10 dark:text-emerald-300 dark:ring-white/15 dark:hover:bg-emerald-400/10 dark:hover:text-emerald-200 dark:hover:ring-emerald-300/50 dark:disabled:bg-white/5 dark:disabled:text-neutral-600 dark:disabled:ring-white/10"
										aria-label="@Localizer["Shopping.CreateList"]"
										disabled="@string.IsNullOrWhiteSpace(newListName)">
									<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
										<path d="M5 13l4 4L19 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.25" />
									</svg>
								</button>
							</div>
						</form>
					</div>
				}
				else
				{
					<div class="flex justify-start py-1">
						<button type="button"
								class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-white text-emerald-600 shadow-[0_12px_30px_rgba(16,185,129,0.18)] ring-1 ring-inset ring-neutral-200 transition duration-500 ease-in hover:-translate-y-0.5 hover:bg-emerald-50 hover:text-emerald-500 hover:ring-emerald-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-400 disabled:pointer-events-none dark:bg-white/10 dark:text-emerald-300 dark:ring-white/15 dark:hover:bg-emerald-400/10 dark:hover:text-emerald-200 dark:hover:ring-emerald-300/50 @(_isAddButtonExiting ? "-translate-x-[110vw] opacity-0" : "translate-x-0 opacity-100")"
								aria-label="@Localizer["Shopping.AddNewList"]"
								disabled="@_isAddButtonExiting"
								@onclick="BeginAddList">
							<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
								<path d="M12 5v14M5 12h14" stroke="currentColor" stroke-linecap="round" stroke-width="2.25" />
							</svg>
						</button>
					</div>
				}
			</section>

			@if (ActiveLists.Count == 0)
			{
				<div class="rounded-[1.5rem] border border-dashed border-neutral-300 bg-white px-6 py-10 text-center text-sm text-neutral-500 shadow-sm dark:border-white/10 dark:bg-white/5 dark:text-neutral-400">
					@Localizer["Shopping.EmptyState"]
				</div>
			}

			@if (VisibleLists.Count > 0)
			{
				<div class="grid gap-3">
					@{ var archivedHeadingRendered = false; }
					@foreach (var list in VisibleLists)
					{
						@if (list.Archived && !archivedHeadingRendered)
						{
							archivedHeadingRendered = true;
							<div class="border-t border-neutral-200 pt-6 dark:border-white/10">
								<h2 class="text-sm font-semibold uppercase tracking-[0.18em] text-neutral-500 dark:text-neutral-400">@Localizer["Common.Archived"]</h2>
							</div>
						}

						<article class="rounded-[1.5rem] border border-neutral-200 bg-white p-3 shadow-sm transition hover:border-neutral-300 hover:shadow-md dark:border-white/10 dark:bg-neutral-900/90 dark:text-neutral-100 dark:hover:bg-neutral-900">
							<button class="group w-full rounded-[1.25rem] p-2 text-left transition hover:bg-neutral-50 dark:hover:bg-white/5"
									@onclick="() => OpenList(list.Id)">
								<div class="flex items-start justify-between gap-4">
									<div class="min-w-0 space-y-1">
										<h2 class="text-lg font-semibold tracking-tight text-neutral-950 dark:text-white">@list.Name</h2>
										<p class="text-sm text-neutral-600 dark:text-neutral-400">@list.Description</p>
									</div>
									<span class="shrink-0 rounded-full bg-neutral-950 px-3 py-1 text-xs font-medium text-white dark:bg-emerald-400 dark:text-neutral-950">@GetSummary(list)</span>
								</div>
							</button>

							@if (renamingListId == list.Id)
							{
								<form class="mt-3 flex flex-col gap-2 sm:flex-row sm:items-center" @onsubmit="() => RenameList(list.Id)">
									<input class="min-w-0 flex-1 rounded-2xl border border-neutral-200 bg-white px-3 py-2 text-sm font-semibold text-neutral-950 outline-none ring-emerald-500/30 placeholder:text-neutral-400 focus:ring-2 dark:border-white/10 dark:bg-white/5 dark:text-white dark:ring-emerald-400/40 dark:placeholder:text-neutral-500"
									       placeholder="@Localizer["Shopping.ListNamePlaceholder"]"
										   @bind="editableListName"
										   @bind:event="oninput"
										   autofocus />
									<div class="flex items-center gap-2 sm:shrink-0">
										<button type="submit"
												class="rounded-full bg-emerald-400 px-4 py-2 text-sm font-semibold text-neutral-950 transition hover:bg-emerald-300 disabled:cursor-not-allowed disabled:bg-neutral-700 disabled:text-neutral-400"
												disabled="@string.IsNullOrWhiteSpace(editableListName)">
											@Localizer["Common.Save"]
										</button>
										<button type="button"
												class="rounded-full border border-neutral-200 bg-white px-4 py-2 text-sm font-medium text-neutral-700 transition hover:bg-neutral-50 dark:border-white/10 dark:bg-white/5 dark:text-neutral-200 dark:hover:bg-white/10"
												@onclick="CancelListRename">
											@Localizer["Common.Cancel"]
										</button>
									</div>
								</form>
							}
							else
							{
								<div class="mt-3 flex flex-wrap items-center gap-2">
									<button type="button"
											class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-neutral-200 bg-white text-neutral-700 shadow-sm transition hover:bg-neutral-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 focus-visible:ring-offset-white dark:border-white/10 dark:bg-white/5 dark:text-neutral-200 dark:hover:bg-white/10 dark:focus-visible:ring-offset-neutral-900"
											aria-label="@FormatText("Shopping.RenameList", list.Name)"
											title="@Localizer["Common.Rename"]"
											@onclick="() => BeginListRename(list)">
										<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
											<path stroke-linecap="round" stroke-linejoin="round" d="m16.862 3.487 3.651 3.651M7.5 20.25l-4.5.75.75-4.5L15.8 4.45a2.582 2.582 0 0 1 3.65 0l.413.413a2.582 2.582 0 0 1 0 3.65L7.5 20.25Z" />
										</svg>
									</button>

									@if (list.Archived)
									{
										<button class="rounded-full border border-neutral-200 bg-white px-4 py-2 text-sm font-medium text-neutral-700 transition hover:bg-neutral-50 dark:border-white/10 dark:bg-white/5 dark:text-neutral-200 dark:hover:bg-white/10"
												@onclick="() => UnarchiveList(list.Id)">
											@Localizer["Common.Unarchive"]
										</button>
										<button class="rounded-full border border-rose-200 bg-rose-50 px-4 py-2 text-sm font-semibold text-rose-700 transition hover:bg-rose-100 dark:border-rose-500/20 dark:bg-rose-500/10 dark:text-rose-300 dark:hover:bg-rose-500/15"
												@onclick="() => RemoveArchivedList(list.Id)">
											@Localizer["Common.Remove"]
										</button>
									}
									else
									{
										<button class="rounded-full border border-neutral-200 bg-white px-4 py-2 text-sm font-medium text-neutral-700 transition hover:bg-neutral-50 dark:border-white/10 dark:bg-white/5 dark:text-neutral-200 dark:hover:bg-white/10"
												@onclick="() => ArchiveList(list.Id)">
											@Localizer["Common.Archive"]
										</button>
									}
								</div>
							}
						</article>
					}
				</div>
			}
		</div>
	</section>
</div>

@code {
	private int? renamingListId;
	private string editableListName = string.Empty;
	private string newListName = string.Empty;
	private string newListDescription = string.Empty;
	private List<ShoppingList> shoppingLists = [];
	private bool _isAddComposerOpen;
	private bool _isAddComposerEntering;
	private bool _isAddButtonExiting;

	private List<ShoppingList> ActiveLists => shoppingLists.Where(list => !list.Archived).ToList();
	private List<ShoppingList> ArchivedLists => shoppingLists.Where(list => list.Archived).ToList();
	private List<ShoppingList> VisibleLists => [.. ActiveLists, .. ArchivedLists];

	protected override async Task OnInitializedAsync()
	{
		StoreChangeNotifier.Changed += HandleStoreChangedAsync;
		shoppingLists = [.. await ShoppingLists.GetListsAsync()];
	}

	public void Dispose()
	{
		StoreChangeNotifier.Changed -= HandleStoreChangedAsync;
	}

	private void OpenList(int id)
	{
		Navigation.NavigateTo($"/lists/{id}");
	}

	private void BeginListRename(ShoppingList list)
	{
		renamingListId = list.Id;
		editableListName = list.Name;
	}

	private void CancelListRename()
	{
		renamingListId = null;
		editableListName = string.Empty;
	}

	private async Task RenameList(int id)
	{
		if (string.IsNullOrWhiteSpace(editableListName))
		{
			return;
		}

		await ShoppingLists.RenameListAsync(id, editableListName);
		CancelListRename();
		shoppingLists = [.. await ShoppingLists.GetListsAsync()];
	}

	private async Task ArchiveList(int id)
	{
		await ShoppingLists.ArchiveListAsync(id);
		CancelListRename();
		shoppingLists = [.. await ShoppingLists.GetListsAsync()];
	}

	private async Task UnarchiveList(int id)
	{
		await ShoppingLists.UnarchiveListAsync(id);
		CancelListRename();
		shoppingLists = [.. await ShoppingLists.GetListsAsync()];
	}

	private async Task BeginAddList()
	{
		if (_isAddComposerOpen || _isAddButtonExiting)
		{
			return;
		}

		_isAddButtonExiting = true;
		await Task.Delay(450);

		_isAddComposerOpen = true;
		_isAddComposerEntering = true;
		_isAddButtonExiting = false;
		StateHasChanged();

		await Task.Delay(20);
		_isAddComposerEntering = false;
	}

	private void CancelAddComposer()
	{
		_isAddComposerOpen = false;
		_isAddComposerEntering = false;
		_isAddButtonExiting = false;
		newListName = string.Empty;
		newListDescription = string.Empty;
	}

	private async Task CreateList()
	{
		if (string.IsNullOrWhiteSpace(newListName))
		{
			return;
		}

		var list = await ShoppingLists.CreateListAsync(newListName, newListDescription);
		newListName = string.Empty;
		newListDescription = string.Empty;
		_isAddComposerOpen = false;
		_isAddComposerEntering = false;
		_isAddButtonExiting = false;
		Navigation.NavigateTo($"/lists/{list.Id}");
	}

	private async Task RemoveArchivedList(int id)
	{
		if (!await ShoppingLists.RemoveArchivedListAsync(id))
		{
			return;
		}

		shoppingLists.RemoveAll(list => list.Id == id);
		CancelListRename();
	}

	private Task HandleStoreChangedAsync(StoreChange _)
	{
		return InvokeAsync(async () =>
		{
			shoppingLists = [.. await ShoppingLists.GetListsAsync()];
			StateHasChanged();
		});
	}

	private string GetSummary(ShoppingList list)
	{
		var purchasedCount = list.Items.Count(item => item.IsDone);
		return string.Format(Localizer["Shopping.ListSummary"].Value, purchasedCount, list.Items.Count);
	}

	private string FormatText(string key, params object[] arguments)
	{
		return string.Format(Localizer[key].Value, arguments);
	}
}
