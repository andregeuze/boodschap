@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@inject NavigationManager Navigation
@inject IShoppingListService ShoppingLists
@inject StoreChangeNotifier StoreChangeNotifier

<PageTitle>Boodschap</PageTitle>

<div class="min-h-screen">
	<section class="mx-auto flex w-full max-w-5xl flex-col gap-5 px-4 py-6 sm:px-6 sm:py-8">
		<div class="space-y-3">
			<p class="text-sm font-semibold uppercase tracking-[0.28em] text-emerald-600 dark:text-emerald-400">Shopping lists</p>
			<div class="space-y-2">
				<h1 class="text-3xl font-black tracking-tight text-neutral-950 dark:text-white sm:text-4xl">Pick a list and keep moving.</h1>
				<p class="max-w-2xl text-sm leading-6 text-neutral-600 dark:text-neutral-300">Your active lists stay front and center, while archived lists remain easy to revisit.</p>
			</div>
		</div>

		<div class="space-y-4">
			<TabBar Tabs="Tabs"
					ActiveTab="@activeTab"
					OnTabChanged="SelectTab"
					AriaLabel="Shopping list status" />

			@if (VisibleLists.Count == 0)
			{
				<div class="rounded-[1.5rem] border border-dashed border-neutral-300 bg-white px-6 py-10 text-center text-sm text-neutral-500 shadow-sm dark:border-white/10 dark:bg-white/5 dark:text-neutral-400">
					No lists in this view yet.
				</div>
			}
			else
			{
				<div class="grid gap-3">
					@foreach (var list in VisibleLists)
					{
						<div class="flex flex-col gap-3 sm:flex-row sm:items-stretch">
							<button class="group w-full rounded-[1.5rem] border border-neutral-200 bg-white p-5 text-left shadow-sm transition hover:-translate-y-0.5 hover:border-neutral-300 hover:shadow-md dark:border-white/10 dark:bg-neutral-900/90 dark:text-neutral-100 dark:hover:bg-neutral-900 sm:flex-1"
									@onclick="() => OpenList(list.Id)">
								<div class="flex items-start justify-between gap-4">
									<div class="space-y-1">
										<h2 class="text-lg font-semibold tracking-tight text-neutral-950 dark:text-white">@list.Name</h2>
										<p class="text-sm text-neutral-600 dark:text-neutral-400">@list.Description</p>
									</div>
									<span class="rounded-full bg-neutral-950 px-3 py-1 text-xs font-medium text-white dark:bg-emerald-400 dark:text-neutral-950">@GetSummary(list)</span>
								</div>
							</button>

							@if (list.Archived)
							{
								<button class="rounded-[1.5rem] border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-semibold text-rose-700 transition hover:bg-rose-100 dark:border-rose-500/20 dark:bg-rose-500/10 dark:text-rose-300 dark:hover:bg-rose-500/15 sm:self-stretch"
										@onclick="() => RemoveArchivedList(list.Id)">
									Remove
								</button>
							}
						</div>
					}
				</div>
			}
		</div>

		<section class="pt-2">
			<div class="mx-auto w-full max-w-5xl rounded-[2rem] border border-neutral-200 bg-white p-4 shadow-[0_18px_50px_rgba(0,0,0,0.10)] transition-colors duration-300 dark:border-white/10 dark:bg-neutral-900 sm:p-5">
				@if (_isAddComposerOpen)
				{
					<div class="flex flex-col gap-4 sm:min-h-24 sm:flex-row sm:items-center sm:justify-between">
						<input class="w-full border-0 border-b border-neutral-300 bg-transparent px-1 py-3 text-2xl font-light tracking-tight text-neutral-950 outline-none placeholder:text-neutral-300 focus:border-emerald-500 focus:ring-0 dark:border-white/15 dark:text-white dark:placeholder:text-neutral-600 dark:focus:border-emerald-400"
						       placeholder="Title"
						       @bind="newListName"
						       @bind:event="oninput"
						       autofocus />

						<div class="flex items-center justify-end gap-2 sm:shrink-0">
							<button type="button"
									class="flex h-14 w-14 items-center justify-center rounded-full border border-neutral-300 bg-white text-2xl font-light leading-none text-neutral-700 shadow-sm transition hover:bg-neutral-50 dark:border-white/15 dark:bg-white/5 dark:text-neutral-100 dark:hover:bg-white/10"
									aria-label="Cancel"
									@onclick="CancelAddComposer">
								×
							</button>
							<button type="button"
									class="flex h-14 w-14 items-center justify-center rounded-full border border-emerald-500 bg-emerald-500 text-2xl font-semibold leading-none text-white shadow-sm transition hover:bg-emerald-400 disabled:cursor-not-allowed disabled:border-neutral-200 disabled:bg-neutral-200 disabled:text-neutral-400 dark:border-emerald-400 dark:bg-emerald-400 dark:text-neutral-950 dark:hover:bg-emerald-300 dark:disabled:border-neutral-700 dark:disabled:bg-neutral-700 dark:disabled:text-neutral-500"
									aria-label="Create list"
									disabled="@string.IsNullOrWhiteSpace(newListName)"
									@onclick="CreateList">
								✓
							</button>
						</div>
					</div>
				}
				else
				{
					<div class="flex justify-center py-2">
						<button type="button"
								class="inline-flex items-center rounded-full border border-neutral-200 bg-white px-4 py-2 text-sm font-medium text-neutral-700 shadow-sm transition hover:bg-neutral-50 dark:border-white/10 dark:bg-white/5 dark:text-neutral-300 dark:hover:bg-white/10"
								aria-label="Add new list"
								@onclick="BeginAddList">
							<span class="mr-2 text-lg leading-none">+</span>
							Add list
						</button>
					</div>
				}
			</div>
		</section>
	</section>
</div>

@code {
	private const string NewTab = "New";
	private const string ArchivedTab = "Archived";

	private static readonly string[] Tabs = [NewTab, ArchivedTab];

	[SupplyParameterFromQuery(Name = "tab")]
	public string? RequestedTab { get; set; }

	private string activeTab = NewTab;
	private string newListName = string.Empty;
	private List<ShoppingList> shoppingLists = [];
	private bool _isAddComposerOpen;

	private List<ShoppingList> VisibleLists => shoppingLists
		.Where(list => activeTab == ArchivedTab ? list.Archived : !list.Archived)
		.ToList();

	protected override async Task OnInitializedAsync()
	{
		StoreChangeNotifier.Changed += HandleStoreChangedAsync;
		shoppingLists = [.. await ShoppingLists.GetListsAsync()];
	}

	protected override void OnParametersSet()
	{
		activeTab = RequestedTab == ArchivedTab ? ArchivedTab : NewTab;
	}

	public void Dispose()
	{
		StoreChangeNotifier.Changed -= HandleStoreChangedAsync;
	}

	private void SelectTab(string tab)
	{
		activeTab = tab;
	}

	private void OpenList(int id)
	{
		Navigation.NavigateTo($"/lists/{id}");
	}

	private void BeginAddList()
	{
		_isAddComposerOpen = true;
	}

	private void CancelAddComposer()
	{
		_isAddComposerOpen = false;
		newListName = string.Empty;
	}

	private async Task CreateList()
	{
		if (string.IsNullOrWhiteSpace(newListName))
		{
			return;
		}

		var list = await ShoppingLists.CreateListAsync(newListName);
		newListName = string.Empty;
		_isAddComposerOpen = false;
		Navigation.NavigateTo($"/lists/{list.Id}");
	}

	private async Task RemoveArchivedList(int id)
	{
		if (!await ShoppingLists.RemoveArchivedListAsync(id))
		{
			return;
		}

		shoppingLists.RemoveAll(list => list.Id == id);
	}

	private Task HandleStoreChangedAsync(StoreChange _)
	{
		return InvokeAsync(async () =>
		{
			shoppingLists = [.. await ShoppingLists.GetListsAsync()];
			StateHasChanged();
		});
	}

	private static string GetSummary(ShoppingList list)
	{
		var purchasedCount = list.Items.Count(item => item.IsDone);
		return $"{purchasedCount}/{list.Items.Count} purchased";
	}
}
