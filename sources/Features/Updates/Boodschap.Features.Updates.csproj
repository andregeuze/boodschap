<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <RepositoryCommit Condition="'$(RepositoryCommit)' == '' and '$(GITHUB_SHA)' != ''">$(GITHUB_SHA)</RepositoryCommit>
    <RepositoryCommit Condition="'$(RepositoryCommit)' == '' and '$(BUILD_COMMIT)' != ''">$(BUILD_COMMIT)</RepositoryCommit>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\Shared\Boodschap.Shared.csproj" />
  </ItemGroup>

  <Target Name="ResolveRepositoryCommit" BeforeTargets="CoreCompile">
    <Exec Command="git rev-parse HEAD"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMsBuild="true"
          StandardOutputImportance="Low"
          IgnoreExitCode="true"
          Condition="'$(RepositoryCommit)' == ''">
      <Output TaskParameter="ConsoleOutput" PropertyName="RepositoryCommit" />
    </Exec>
    <ItemGroup Condition="'$(RepositoryCommit)' != ''">
      <_RepositoryCommitAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>RepositoryCommit</_Parameter1>
        <_Parameter2>$(RepositoryCommit)</_Parameter2>
      </_RepositoryCommitAttribute>
    </ItemGroup>
    <WriteCodeFragment Language="C#"
                       OutputFile="$(IntermediateOutputPath)RepositoryCommit.AssemblyInfo.cs"
                       AssemblyAttributes="@(_RepositoryCommitAttribute)"
                       Condition="'$(RepositoryCommit)' != ''">
      <Output TaskParameter="OutputFile" ItemName="Compile" />
    </WriteCodeFragment>
  </Target>
</Project>