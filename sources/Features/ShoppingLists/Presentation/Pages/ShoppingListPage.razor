@page "/lists/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@inject NavigationManager Navigation
@inject IShoppingListService ShoppingLists
@inject StoreChangeNotifier StoreChangeNotifier
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@PageTitleText</PageTitle>

@if (shoppingList is null)
{
	<div class="mx-auto flex min-h-screen w-full max-w-3xl flex-col items-center justify-center gap-4 px-4 text-center">
		<h1 class="text-2xl font-semibold text-neutral-100">@Localizer["Shopping.ListNotFound"]</h1>
		<p class="text-sm text-neutral-400">@Localizer["Shopping.ListNotFoundDescription"]</p>
		<button class="rounded-full bg-emerald-400 px-4 py-2 text-sm font-semibold text-neutral-950 hover:bg-emerald-300"
				@onclick="BackToOverview">
			@Localizer["Shopping.BackToOverview"]
		</button>
	</div>
}
else
{
	<div class="min-h-screen">
		<header class="sticky top-0 z-20 border-b border-white/10 bg-neutral-950/80 backdrop-blur">
			<div class="mx-auto flex w-full max-w-5xl items-center gap-4 px-4 py-2 sm:px-6">
				<div class="flex min-w-0 items-center gap-4">
					<button class="inline-flex shrink-0 items-center gap-2 rounded-full bg-emerald-400 px-4 py-2.5 text-sm font-bold text-neutral-950 shadow-lg shadow-emerald-950/20 transition hover:bg-emerald-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-200 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-950"
							@onclick="BackToOverview">
						<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="m15 18-6-6 6-6" />
						</svg>
						@Localizer["Common.Back"]
					</button>

					<div class="min-w-0">
						<h1 class="truncate text-xl font-bold text-white">@shoppingList.Name</h1>
						@if (!string.IsNullOrWhiteSpace(shoppingList.Description))
						{
							<p class="truncate text-xs text-neutral-400">@shoppingList.Description</p>
						}
					</div>
				</div>
			</div>
		</header>

		<section class="mx-auto w-full max-w-5xl px-4 py-4 sm:px-6">
			<div class="mb-4 flex items-center justify-between gap-4">
				<div class="shrink-0">
					<button type="button"
							class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-white text-emerald-600 shadow-[0_12px_30px_rgba(16,185,129,0.18)] ring-1 ring-inset ring-neutral-200 transition duration-500 ease-in hover:-translate-y-0.5 hover:bg-emerald-50 hover:text-emerald-500 hover:ring-emerald-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-400 disabled:pointer-events-none dark:bg-white/10 dark:text-emerald-300 dark:ring-white/15 dark:hover:bg-emerald-400/10 dark:hover:text-emerald-200 dark:hover:ring-emerald-300/50"
							aria-label="@Localizer["Shopping.NewItem"]"
							title="@Localizer["Shopping.NewItem"]"
							@onclick="ToggleQuickAdd">
						<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path d="M12 5v14M5 12h14" stroke="currentColor" stroke-linecap="round" stroke-width="2.25" />
						</svg>
					</button>
				</div>

				<p class="max-w-xs text-right text-sm text-neutral-400">@ItemInteractionHint</p>
			</div>

			@if (isQuickAddOpen)
			{
				<div class="mb-5 w-full max-w-3xl">
					<form class="flex min-w-0 gap-2" @onsubmit="AddItem">
						<input class="min-w-0 flex-1 rounded-full border border-white/10 bg-white/5 px-4 py-3 text-sm text-white outline-none ring-emerald-400/40 placeholder:text-neutral-400 focus:ring-2"
						       placeholder="@Localizer["Shopping.AddGroceryItemPlaceholder"]"
							   @bind="newItemName"
							   @bind:event="oninput"
							   autofocus />
						<button type="submit" class="shrink-0 rounded-full bg-emerald-400 px-4 py-3 text-sm font-semibold text-neutral-950 hover:bg-emerald-300">@Localizer["Common.Add"]</button>
					</form>
				</div>
			}

			<ul class="space-y-2">
				@foreach (var item in VisibleItems)
				{
					<li class="rounded-[1.5rem] border px-3 py-3 shadow-lg shadow-black/10 transition-all duration-150 @(dragOverItem == item ? "border-emerald-400 bg-emerald-400/10 ring-2 ring-emerald-400/30" : "border-white/10 bg-neutral-900/90") @(dragItem == item ? "opacity-50" : "")"
						draggable="@(CanReorderItems ? "true" : "false")"
						@ondragstart="() => HandleDragStart(item)"
						@ondragend="HandleDragEnd"
						@ondragenter="() => HandleDragEnter(item)"
						@ondragover:preventDefault
						@ondrop="() => HandleDrop(item)"
						@key="item.Id">
						@if (editingItemId == item.Id)
						{
							<form class="flex w-full min-w-0 items-center gap-2" @onsubmit="() => RenameItem(item.Id)">
								<input type="checkbox" checked="@item.IsDone" disabled class="h-4 w-4 shrink-0 accent-emerald-400" />
								<input class="min-w-0 flex-1 rounded-full border border-white/10 bg-white/5 px-3 py-2 text-sm text-white outline-none ring-emerald-400/40 placeholder:text-neutral-400 focus:ring-2"
								       placeholder="@Localizer["Shopping.RenameItemPlaceholder"]"
									   @bind="editableItemName"
									   @bind:event="oninput"
									   autofocus />
								<div class="flex shrink-0 items-center gap-2">
									<button type="submit"
											class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-emerald-400 text-neutral-950 transition hover:bg-emerald-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-300 disabled:cursor-not-allowed disabled:bg-neutral-700 disabled:text-neutral-500"
											aria-label="@Localizer["Shopping.SaveItemName"]"
											title="@Localizer["Common.Save"]"
											disabled="@string.IsNullOrWhiteSpace(editableItemName)">
										<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
											<path stroke-linecap="round" stroke-linejoin="round" d="M5 12.75 10 17l9-10" />
										</svg>
									</button>
									<button type="button"
											class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/10 text-neutral-300 transition hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/20"
											aria-label="@Localizer["Shopping.CancelItemRename"]"
											title="@Localizer["Common.Cancel"]"
											@onclick="CancelItemRename">
										<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
											<path stroke-linecap="round" stroke-linejoin="round" d="m6.75 6.75 10.5 10.5m0-10.5-10.5 10.5" />
										</svg>
									</button>
								</div>
							</form>
						}
						else
						{
							<div class="flex min-w-0 cursor-pointer items-center gap-2"
								 @onclick="() => ToggleDone(item.Id, !item.IsDone)">
								<div class="flex min-w-0 flex-1 items-center gap-3">
									<input type="checkbox"
										   checked="@item.IsDone"
										   @onchange="(args) => ToggleDone(item.Id, args.Value is bool done && done)"
										   @onclick:stopPropagation
										   class="h-4 w-4 shrink-0 accent-emerald-400" />
									<span class="block min-w-0 flex-1 truncate text-sm font-medium @(item.IsDone ? "line-through text-neutral-500" : "text-white")">@item.Name</span>
								</div>
								<div class="flex shrink-0 items-center gap-2">
									<button type="button"
											class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/10 text-neutral-300 transition hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/20"
											aria-label="@FormatText("Shopping.RenameItem", item.Name)"
											title="@Localizer["Common.Rename"]"
											@onclick:stopPropagation
											@onclick="() => BeginItemRename(item)">
										<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
											<path stroke-linecap="round" stroke-linejoin="round" d="m16.862 3.487 3.651 3.651M7.5 20.25l-4.5.75.75-4.5L15.8 4.45a2.582 2.582 0 0 1 3.65 0l.413.413a2.582 2.582 0 0 1 0 3.65L7.5 20.25Z" />
										</svg>
									</button>
									<button type="button"
											class="inline-flex h-10 w-10 items-center justify-center rounded-full text-rose-300 transition hover:bg-rose-500/10 hover:text-rose-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-400/20"
											aria-label="@FormatText("Shopping.RemoveItem", item.Name)"
											title="@Localizer["Common.Remove"]"
											@onclick:stopPropagation
											@onclick="() => RemoveItem(item.Id)">
										<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
											<path stroke-linecap="round" stroke-linejoin="round" d="M4.5 7.5h15m-10.5 0V6a1.5 1.5 0 0 1 1.5-1.5h3A1.5 1.5 0 0 1 15 6v1.5m-7.5 0v10.125A1.875 1.875 0 0 0 9.375 19.5h5.25a1.875 1.875 0 0 0 1.875-1.875V7.5M10.5 11.25v4.5m3-4.5v4.5" />
										</svg>
									</button>
								</div>
							</div>
						}
					</li>
				}
			</ul>
		</section>
	</div>
}

@code {
	[Parameter]
	public int Id { get; set; }

	private ShoppingList? shoppingList;
	private ShoppingListItem? dragItem;
	private ShoppingListItem? dragOverItem;
	private int? editingItemId;
	private bool isQuickAddOpen;
	private string editableItemName = string.Empty;
	private string newItemName = string.Empty;
	private bool CanReorderItems => editingItemId is null;
	private string ItemInteractionHint => CanReorderItems
		? Localizer["Shopping.ItemInteractionHintWithReorder"].Value
		: Localizer["Shopping.ItemInteractionHint"].Value;
	private string PageTitleText => shoppingList?.Name ?? Localizer["Shopping.ListNotFound"].Value;
	private List<ShoppingListItem> VisibleItems => shoppingList?.Items ?? [];

	private string FormatText(string key, params object[] arguments)
	{
		return string.Format(Localizer[key].Value, arguments);
	}

	protected override void OnInitialized()
	{
		StoreChangeNotifier.Changed += HandleStoreChangedAsync;
	}

	protected override async Task OnParametersSetAsync()
	{
		shoppingList = await ShoppingLists.GetListAsync(Id);
		CancelItemRename();
	}

	public void Dispose()
	{
		StoreChangeNotifier.Changed -= HandleStoreChangedAsync;
	}

	private void BackToOverview()
	{
		Navigation.NavigateTo("/");
	}

	private void ToggleQuickAdd()
	{
		isQuickAddOpen = !isQuickAddOpen;
	}

	private void BeginItemRename(ShoppingListItem item)
	{
		if (shoppingList is null)
		{
			return;
		}

		HandleDragEnd();
		editingItemId = item.Id;
		editableItemName = item.Name;
	}

	private void CancelItemRename()
	{
		editingItemId = null;
		editableItemName = string.Empty;
	}

	private async Task AddItem()
	{
		if (shoppingList is null || string.IsNullOrWhiteSpace(newItemName))
		{
			return;
		}

		shoppingList = await ShoppingLists.AddItemAsync(Id, newItemName);
		newItemName = string.Empty;
	}

	private async Task RenameItem(int itemId)
	{
		if (shoppingList is null || string.IsNullOrWhiteSpace(editableItemName))
		{
			return;
		}

		shoppingList = await ShoppingLists.RenameItemAsync(Id, itemId, editableItemName) ?? shoppingList;
		CancelItemRename();
	}

	private async Task ToggleDone(int id, object? value)
	{
		if (shoppingList is null)
		{
			return;
		}

		var isDone = value is bool done && done;
		shoppingList = await ShoppingLists.ToggleDoneAsync(Id, id, isDone) ?? shoppingList;
	}

	private async Task RemoveItem(int id)
	{
		if (shoppingList is null)
		{
			return;
		}

		shoppingList = await ShoppingLists.RemoveItemAsync(Id, id) ?? shoppingList;
		if (editingItemId == id)
		{
			CancelItemRename();
		}
	}

	private void HandleDragStart(ShoppingListItem item)
	{
		if (!CanReorderItems)
		{
			return;
		}

		dragItem = item;
	}

	private void HandleDragEnd()
	{
		dragItem = null;
		dragOverItem = null;
	}

	private void HandleDragEnter(ShoppingListItem item)
	{
		if (!CanReorderItems)
		{
			return;
		}

		dragOverItem = item;
	}

	private async Task HandleDrop(ShoppingListItem target)
	{
		if (shoppingList is null || dragItem is null || dragItem == target || !CanReorderItems)
		{
			return;
		}

		shoppingList = await ShoppingLists.ReorderItemAsync(Id, dragItem.Id, target.Id) ?? shoppingList;
		HandleDragEnd();
	}

	private Task HandleStoreChangedAsync(StoreChange change)
	{
		if (change.ListId is int listId && listId != Id)
		{
			return Task.CompletedTask;
		}

		return InvokeAsync(async () =>
		{
			shoppingList = await ShoppingLists.GetListAsync(Id);
			if (shoppingList is null)
			{
				CancelItemRename();
			}
			else if (editingItemId is int itemId && !shoppingList.Items.Any(item => item.Id == itemId))
			{
				CancelItemRename();
			}
			StateHasChanged();
		});
	}
}