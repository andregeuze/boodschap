@inject NavigationManager Navigation
@using Boodschap.Features.Authentication.Application
@inject ILocalAuthenticationService LocalAuthentication
@inject IStringLocalizer<AppStrings> Localizer
@inject IServiceProvider Services

<div class="mx-auto flex min-h-screen w-full max-w-lg items-center justify-center px-4 py-10">
	<div class="w-full rounded-[2rem] border border-neutral-200 bg-white p-8 text-neutral-900 shadow-2xl shadow-black/10 dark:border-white/10 dark:bg-neutral-950/90 dark:text-neutral-100 dark:shadow-black/20">
		<p class="text-xs font-medium uppercase tracking-[0.24em] text-emerald-600 dark:text-emerald-400">@Localizer["Account.AccessEyebrow"]</p>
		<h1 class="mt-3 text-3xl font-black tracking-tight text-neutral-950 dark:text-white">@ResolvedTitle</h1>
		<p class="mt-3 text-sm leading-6 text-neutral-600 dark:text-neutral-400">@ResolvedDescription</p>

		@if (ErrorMessage is not null)
		{
			<div class="mt-6 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-4 text-sm leading-6 text-rose-800 dark:border-rose-500/20 dark:bg-rose-500/10 dark:text-rose-200">
				@ErrorMessage
			</div>
		}

		<div class="mt-6 grid gap-4">
			<form method="post"
				  action="/account/login"
				  class="rounded-2xl border border-neutral-200 bg-neutral-50 p-5 dark:border-white/10 dark:bg-white/5"
				  @onsubmit="SignIn"
				  @onsubmit:preventDefault="@(InteractiveSession is not null)">
				@if (InteractiveSession is null)
				{
					<AntiforgeryToken />
				}
				<input type="hidden" name="returnUrl" value="@NormalizedReturnUrl" />
				<h2 class="text-lg font-semibold text-neutral-950 dark:text-white">@Localizer["Account.SignIn"]</h2>
				<p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">@Localizer["Account.SignInDescription"]</p>

				<div class="mt-4 space-y-4">
					<div class="space-y-1">
						<label class="text-sm font-medium text-neutral-700 dark:text-neutral-300" for="login-username">@Localizer["Account.Username"]</label>
						<input id="login-username"
							   name="username"
							   autocomplete="username"
							   class="w-full rounded-2xl border border-neutral-200 bg-white px-3 py-2 text-sm text-neutral-900 outline-none ring-emerald-500/30 placeholder:text-neutral-400 focus:ring-2 dark:border-white/10 dark:bg-white/5 dark:text-white dark:ring-emerald-400/40 dark:placeholder:text-neutral-500"
							   @bind="username" />
					</div>
					<div class="space-y-1">
						<label class="text-sm font-medium text-neutral-700 dark:text-neutral-300" for="login-password">@Localizer["Account.Password"]</label>
						<input id="login-password"
							   name="password"
							   type="password"
							   autocomplete="current-password"
							   class="w-full rounded-2xl border border-neutral-200 bg-white px-3 py-2 text-sm text-neutral-900 outline-none ring-emerald-500/30 placeholder:text-neutral-400 focus:ring-2 dark:border-white/10 dark:bg-white/5 dark:text-white dark:ring-emerald-400/40 dark:placeholder:text-neutral-500"
							   @bind="password" />
					</div>
				</div>

				<button type="submit" class="mt-5 rounded-full bg-emerald-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-400 dark:bg-emerald-400 dark:text-neutral-950 dark:hover:bg-emerald-300">
					@Localizer["Account.SignIn"]
				</button>
			</form>

			@if (isBootstrapRegistrationOpen)
			{
				<form method="post"
					  action="/account/register"
					  class="rounded-2xl border border-neutral-200 bg-neutral-50 p-5 dark:border-white/10 dark:bg-white/5"
					  @onsubmit="Register"
					  @onsubmit:preventDefault="@(InteractiveSession is not null)">
					@if (InteractiveSession is null)
					{
						<AntiforgeryToken />
					}
					<input type="hidden" name="returnUrl" value="@NormalizedReturnUrl" />
					<h2 class="text-lg font-semibold text-neutral-950 dark:text-white">@Localizer["Account.CreateFirstAccount"]</h2>
					<p class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">@Localizer["Account.CreateFirstAccountDescription"]</p>

					<div class="mt-4 space-y-4">
						<div class="space-y-1">
							<label class="text-sm font-medium text-neutral-700 dark:text-neutral-300" for="register-username">@Localizer["Account.Username"]</label>
							<input id="register-username"
								   name="username"
								   autocomplete="username"
								   class="w-full rounded-2xl border border-neutral-200 bg-white px-3 py-2 text-sm text-neutral-900 outline-none ring-emerald-500/30 placeholder:text-neutral-400 focus:ring-2 dark:border-white/10 dark:bg-white/5 dark:text-white dark:ring-emerald-400/40 dark:placeholder:text-neutral-500"
								   @bind="username" />
						</div>
						<div class="space-y-1">
							<label class="text-sm font-medium text-neutral-700 dark:text-neutral-300" for="register-password">@Localizer["Account.Password"]</label>
							<input id="register-password"
								   name="password"
								   type="password"
								   autocomplete="new-password"
								   class="w-full rounded-2xl border border-neutral-200 bg-white px-3 py-2 text-sm text-neutral-900 outline-none ring-emerald-500/30 placeholder:text-neutral-400 focus:ring-2 dark:border-white/10 dark:bg-white/5 dark:text-white dark:ring-emerald-400/40 dark:placeholder:text-neutral-500"
								   @bind="password" />
						</div>
						<div class="space-y-1">
							<label class="text-sm font-medium text-neutral-700 dark:text-neutral-300" for="register-confirm-password">@Localizer["Account.ConfirmPassword"]</label>
							<input id="register-confirm-password"
								   name="confirmPassword"
								   type="password"
								   autocomplete="new-password"
								   class="w-full rounded-2xl border border-neutral-200 bg-white px-3 py-2 text-sm text-neutral-900 outline-none ring-emerald-500/30 placeholder:text-neutral-400 focus:ring-2 dark:border-white/10 dark:bg-white/5 dark:text-white dark:ring-emerald-400/40 dark:placeholder:text-neutral-500"
								   @bind="confirmPassword" />
						</div>
					</div>

					<p class="mt-4 text-xs text-neutral-500 dark:text-neutral-500">@Localizer["Account.PasswordHelp"]</p>

					<button type="submit" class="mt-5 rounded-full border border-neutral-200 bg-white px-4 py-2 text-sm font-medium text-neutral-800 transition hover:bg-neutral-50 dark:border-white/10 dark:bg-white/5 dark:text-neutral-100 dark:hover:bg-white/10">
						@Localizer["Account.CreateAccount"]
					</button>
				</form>
			}
			else
			{
				<div class="rounded-2xl border border-neutral-200 bg-neutral-50 p-5 text-sm leading-6 text-neutral-600 dark:border-white/10 dark:bg-white/5 dark:text-neutral-400">
					@Localizer["Account.RegisterClosed"]
				</div>
			}
		</div>
	</div>
</div>

@code {
	private bool isBootstrapRegistrationOpen;
	private string username = string.Empty;
	private string password = string.Empty;
	private string confirmPassword = string.Empty;
	private string? interactiveErrorCode;
	private bool usernameInitialized;

	[Parameter]
	public string? Title { get; set; }

	[Parameter]
	public string? Description { get; set; }

	[Parameter]
	public string? ReturnUrl { get; set; }

	[Parameter]
	public string? ErrorCode { get; set; }

	[Parameter]
	public string? SuggestedUsername { get; set; }

	private string ResolvedTitle => string.IsNullOrWhiteSpace(Title) ? Localizer["Account.DefaultTitle"].Value : Title;
	private string ResolvedDescription => string.IsNullOrWhiteSpace(Description) ? Localizer["Account.DefaultDescription"].Value : Description;

	private ILocalAuthenticationSession? InteractiveSession => Services.GetService<ILocalAuthenticationSession>();

	private string? ErrorMessage => (interactiveErrorCode ?? ErrorCode) switch
	{
		LocalAuthenticationErrorCodes.InvalidCredentials => Localizer["Account.Error.InvalidCredentials"].Value,
		LocalAuthenticationErrorCodes.AdminRequired => Localizer["Account.Error.AdminRequired"].Value,
		LocalAuthenticationErrorCodes.BootstrapRegistrationClosed => Localizer["Account.Error.BootstrapRegistrationClosed"].Value,
		LocalAuthenticationErrorCodes.UsernameRequired => Localizer["Account.Error.UsernameRequired"].Value,
		LocalAuthenticationErrorCodes.PasswordRequired => Localizer["Account.Error.PasswordRequired"].Value,
		LocalAuthenticationErrorCodes.PasswordTooShort => Localizer["Account.Error.PasswordTooShort"].Value,
		LocalAuthenticationErrorCodes.PasswordMismatch => Localizer["Account.Error.PasswordMismatch"].Value,
		LocalAuthenticationErrorCodes.UsernameTaken => Localizer["Account.Error.UsernameTaken"].Value,
		_ => null
	};

	protected override async Task OnParametersSetAsync()
	{
		if (!usernameInitialized)
		{
			username = SuggestedUsername ?? string.Empty;
			usernameInitialized = true;
		}

		isBootstrapRegistrationOpen = await LocalAuthentication.IsBootstrapRegistrationOpenAsync();
	}

	private async Task SignIn()
	{
		if (InteractiveSession is null)
		{
			return;
		}

		var result = await LocalAuthentication.LoginAsync(username, password);
		interactiveErrorCode = result.ErrorCode;
		if (!result.Succeeded || result.User is null)
		{
			return;
		}

		await InteractiveSession.SignInAsync(result.User);
		Navigation.NavigateTo(NormalizedReturnUrl, replace: true);
	}

	private async Task Register()
	{
		if (InteractiveSession is null)
		{
			return;
		}

		var result = await LocalAuthentication.RegisterAsync(username, password, confirmPassword);
		interactiveErrorCode = result.ErrorCode;
		if (!result.Succeeded || result.User is null)
		{
			return;
		}

		await InteractiveSession.SignInAsync(result.User);
		Navigation.NavigateTo(NormalizedReturnUrl, replace: true);
	}

	private string NormalizedReturnUrl
	{
		get
		{
			if (!string.IsNullOrWhiteSpace(ReturnUrl))
			{
				return ReturnUrl;
			}

			var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
			if (string.IsNullOrWhiteSpace(relativePath))
			{
				return "/";
			}

			return relativePath.StartsWith('/') ? relativePath : $"/{relativePath}";
		}
	}
}