<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Boodschap.Mobile.Presentation.Views"
             x:Class="Boodschap.Mobile.MainPage"
             BackgroundColor="#070708">

       <Grid RowDefinitions="Auto,*,Auto">
              <Grid Grid.Row="0"
                       RowDefinitions="Auto,1"
                       BackgroundColor="#0A0A0A">
					 <Grid x:Name="TopBar"
							  ColumnDefinitions="*,Auto"
							  Padding="16,12,16,12">
							<HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                   <Image x:Name="LogoImage"
                                             Source="favicon.png"
                                             HeightRequest="40"
                                             WidthRequest="40"
                                             Aspect="AspectFit">
                                          <Image.GestureRecognizers>
                                                 <TapGestureRecognizer Command="{Binding HomeCommand}" />
                                          </Image.GestureRecognizers>
                                   </Image>
                                                           <Label Text="Boodschap"
                                                                        Style="{StaticResource HeaderBrandStyle}"
                                                                        VerticalOptions="Center" />
                            </HorizontalStackLayout>

                                                 <ImageButton x:Name="OverflowMenuButton"
                                                                       Grid.Column="1"
                                                                       Source="ellipsis_vertical.svg"
                                                                       Style="{StaticResource HeaderMenuButtonStyle}"
                                                                       Command="{Binding ToggleOverflowMenuCommand}"
                                                                       IsVisible="{Binding IsSignedIn}"
                                                                       IsEnabled="{Binding CanSignOut}" />
                     </Grid>

                     <BoxView Grid.Row="1" Color="#262626" />
              </Grid>

              <Grid Grid.Row="1">
                     <ScrollView>
                            <VerticalStackLayout Padding="16,16,16,32" Spacing="16">
                                   <Border BackgroundColor="{Binding StatusBackgroundColor}"
                                                 Stroke="{Binding StatusBorderColor}"
                                                 StrokeThickness="1"
                                                 Padding="14"
                                                 IsVisible="{Binding IsStatusVisible}">
                                          <Border.StrokeShape>
                                                 <RoundRectangle CornerRadius="18" />
                                          </Border.StrokeShape>
                                          <Label Text="{Binding StatusMessage}"
                                                    TextColor="{Binding StatusTextColor}" />
                                   </Border>

                                   <views:LoginView BindingContext="{Binding Login}" />
                                   <views:ShoppingOverviewView BindingContext="{Binding Overview}" />
                                   <views:ShoppingListDetailView BindingContext="{Binding Detail}" />
                                   <views:AccountView BindingContext="{Binding Account}" />
                            </VerticalStackLayout>
                     </ScrollView>

                     <Grid BackgroundColor="#BF070708"
                              IsVisible="{Binding IsBusy}"
                              InputTransparent="False">
                            <ActivityIndicator IsRunning="True"
                                                    Color="#34D399"
                                                    HeightRequest="48"
                                                    WidthRequest="48"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center" />
                     </Grid>

                                    <Grid IsVisible="{Binding IsOverflowMenuOpen}"
                                                 ZIndex="20">
                                                 <Border HorizontalOptions="End"
                                                               VerticalOptions="Start"
                                                               WidthRequest="220"
                                                               Margin="0,8,16,0"
                                                               Padding="8"
                                                               BackgroundColor="#171717"
                                                               Stroke="#2A2A2A"
                                                               StrokeThickness="1"
                                                               ZIndex="1">
                                                        <Border.StrokeShape>
                                                               <RoundRectangle CornerRadius="12" />
                                                        </Border.StrokeShape>
                                                        <VerticalStackLayout Spacing="2">
                                                               <Button Text="{Binding AccountAccessibilityName}"
                                                                             ImageSource="account.svg"
                                                                             Style="{StaticResource OverflowMenuItemButtonStyle}"
                                                                             Command="{Binding AccountCommand}" />
                                                               <BoxView HeightRequest="1" Color="#1AFFFFFF" Margin="8,2" />
                                                               <Button Text="{Binding SignOutText}"
                                                                             ImageSource="sign_out.svg"
                                                                             TextColor="#FCA5A5"
                                                                             Style="{StaticResource OverflowMenuItemButtonStyle}"
                                                                             Command="{Binding SignOutCommand}" />
                                                        </VerticalStackLayout>
                                                 </Border>
                                    </Grid>
              </Grid>

                       <Border Grid.Row="2"
                                     Margin="12,6,12,8"
                                     Padding="8,6"
                                     BackgroundColor="#111111"
                                     Stroke="#2A2A2A"
                                     StrokeThickness="1"
                                     IsVisible="{Binding IsSignedIn}">
                             <Border.StrokeShape>
                                   <RoundRectangle CornerRadius="28" />
                             </Border.StrokeShape>
                             <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                                   <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                                          <ImageButton x:Name="ShoppingListsButton"
                                                                Source="menu_active.svg"
                                                                Style="{StaticResource BottomNavigationActiveIconButtonStyle}"
                                                                Command="{Binding HomeCommand}" />
                                          <Label Text="{Binding ShoppingTabText}" Style="{StaticResource BottomNavigationActiveLabelStyle}" />
                                   </VerticalStackLayout>

                                   <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center" Opacity="0.38">
                                          <ImageButton x:Name="RecipesTabButton"
                                                                Source="book_open.svg"
                                                                Style="{StaticResource BottomNavigationIconButtonStyle}"
                                                                IsEnabled="False" />
                                          <Label Text="{Binding RecipesTabText}" Style="{StaticResource BottomNavigationLabelStyle}" />
                                   </VerticalStackLayout>

                                   <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center" Opacity="0.38">
                                          <ImageButton x:Name="NutritionTabButton"
                                                                Source="utensils.svg"
                                                                Style="{StaticResource BottomNavigationIconButtonStyle}"
                                                                IsEnabled="False" />
                                          <Label Text="{Binding NutritionTabText}" Style="{StaticResource BottomNavigationLabelStyle}" />
                                   </VerticalStackLayout>

                                   <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center" Opacity="0.38">
                                          <ImageButton x:Name="UpdatesTabButton"
                                                                Source="refresh_cw.svg"
                                                                Style="{StaticResource BottomNavigationIconButtonStyle}"
                                                                IsEnabled="False" />
                                          <Label Text="{Binding UpdatesTabText}" Style="{StaticResource BottomNavigationLabelStyle}" />
                                   </VerticalStackLayout>
                             </Grid>
                       </Border>
       </Grid>

</ContentPage>
