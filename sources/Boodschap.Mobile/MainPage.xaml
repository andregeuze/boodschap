<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Boodschap.Mobile.MainPage"
             x:Name="RootPage"
             BackgroundColor="#070708">

       <ContentPage.Resources>
              <Style x:Key="PageHeadingStyle" TargetType="Label">
                     <Setter Property="TextColor" Value="#F5F5F5" />
                     <Setter Property="FontSize" Value="28" />
                     <Setter Property="FontFamily" Value="OpenSansSemibold" />
              </Style>

              <Style x:Key="SectionHeadingStyle" TargetType="Label">
                     <Setter Property="TextColor" Value="#F5F5F5" />
                     <Setter Property="FontSize" Value="20" />
                     <Setter Property="FontFamily" Value="OpenSansSemibold" />
              </Style>

              <Style x:Key="EyebrowStyle" TargetType="Label">
                     <Setter Property="TextColor" Value="#34D399" />
                     <Setter Property="FontSize" Value="13" />
                     <Setter Property="FontFamily" Value="OpenSansSemibold" />
              </Style>

              <Style x:Key="BodyStyle" TargetType="Label">
                     <Setter Property="TextColor" Value="#A3A3A3" />
                     <Setter Property="FontSize" Value="14" />
                     <Setter Property="LineBreakMode" Value="WordWrap" />
              </Style>

              <Style x:Key="InputStyle" TargetType="Entry">
                     <Setter Property="BackgroundColor" Value="#171717" />
                     <Setter Property="TextColor" Value="#F5F5F5" />
                     <Setter Property="PlaceholderColor" Value="#737373" />
                     <Setter Property="ClearButtonVisibility" Value="WhileEditing" />
                     <Setter Property="Margin" Value="0,6,0,0" />
              </Style>

              <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                     <Setter Property="BackgroundColor" Value="#34D399" />
                     <Setter Property="TextColor" Value="#171717" />
                     <Setter Property="CornerRadius" Value="18" />
                     <Setter Property="Padding" Value="16,12" />
                     <Setter Property="FontFamily" Value="OpenSansSemibold" />
              </Style>

              <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                     <Setter Property="BackgroundColor" Value="#171717" />
                     <Setter Property="TextColor" Value="#F5F5F5" />
                     <Setter Property="CornerRadius" Value="18" />
                     <Setter Property="Padding" Value="14,10" />
                     <Setter Property="BorderColor" Value="#262626" />
                     <Setter Property="BorderWidth" Value="1" />
                     <Setter Property="FontFamily" Value="OpenSansSemibold" />
              </Style>

              <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                     <Setter Property="TextColor" Value="#FCA5A5" />
                     <Setter Property="BorderColor" Value="#7F1D1D" />
              </Style>

              <Style x:Key="TitleButtonStyle" TargetType="Button">
                     <Setter Property="BackgroundColor" Value="Transparent" />
                     <Setter Property="TextColor" Value="#F5F5F5" />
                     <Setter Property="Padding" Value="0" />
                     <Setter Property="HorizontalOptions" Value="Start" />
                     <Setter Property="FontSize" Value="22" />
                     <Setter Property="FontFamily" Value="OpenSansSemibold" />
              </Style>

              <DataTemplate x:Key="ActiveListTemplate">
                     <Border BackgroundColor="#111111"
                                   Stroke="#202020"
                                   StrokeThickness="1"
                                   Padding="16">
                            <Border.StrokeShape>
                                   <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="12">
                                   <Button Text="{Binding Name}"
                                                 Style="{StaticResource TitleButtonStyle}"
                                                 Clicked="HandleOpenListClicked" />
                                   <Label Text="{Binding Description}" Style="{StaticResource BodyStyle}" />
                                   <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start" AlignItems="Center">
                                          <Button Text="{Binding Source={x:Reference RootPage}, Path=EditButtonText}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Margin="0,0,8,8"
                                                        Clicked="HandleEditListClicked" />
                                          <Button Text="{Binding Source={x:Reference RootPage}, Path=ArchiveButtonText}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Margin="0,0,8,8"
                                                        Clicked="HandleArchiveListClicked" />
                                   </FlexLayout>
                            </VerticalStackLayout>
                     </Border>
              </DataTemplate>

              <DataTemplate x:Key="ArchivedListTemplate">
                     <Border BackgroundColor="#111111"
                                   Stroke="#202020"
                                   StrokeThickness="1"
                                   Padding="16">
                            <Border.StrokeShape>
                                   <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="12">
                                   <Label Text="{Binding Name}" Style="{StaticResource SectionHeadingStyle}" />
                                   <Label Text="{Binding Description}" Style="{StaticResource BodyStyle}" />
                                   <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start" AlignItems="Center">
                                          <Button Text="{Binding Source={x:Reference RootPage}, Path=EditButtonText}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Margin="0,0,8,8"
                                                        Clicked="HandleEditListClicked" />
                                          <Button Text="{Binding Source={x:Reference RootPage}, Path=UnarchiveButtonText}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Margin="0,0,8,8"
                                                        Clicked="HandleUnarchiveListClicked" />
                                          <Button Text="{Binding Source={x:Reference RootPage}, Path=RemoveButtonText}"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        Margin="0,0,8,8"
                                                        Clicked="HandleRemoveArchivedListClicked" />
                                   </FlexLayout>
                            </VerticalStackLayout>
                     </Border>
              </DataTemplate>

              <DataTemplate x:Key="ShoppingItemTemplate">
                     <Border BackgroundColor="#111111"
                                   Stroke="#202020"
                                   StrokeThickness="1"
                                   Padding="14">
                            <Border.StrokeShape>
                                   <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                   <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                            ColumnSpacing="10">
                                          <CheckBox IsChecked="{Binding IsDone}"
                                                          VerticalOptions="Center"
                                                          Color="#34D399"
                                                          CheckedChanged="HandleItemCheckedChanged" />
                                          <Label Grid.Column="1"
                                                    Text="{Binding Name}"
                                                    VerticalOptions="Center"
                                                    TextColor="#F5F5F5"
                                                    LineBreakMode="WordWrap">
                                                 <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsDone}" Value="True">
                                                               <Setter Property="TextColor" Value="#737373" />
                                                               <Setter Property="TextDecorations" Value="Strikethrough" />
                                                        </DataTrigger>
                                                 </Label.Triggers>
                                          </Label>
                                          <Button Grid.Column="2"
                                                        Text="{Binding Source={x:Reference RootPage}, Path=MoveUpButtonText}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Padding="10,8"
                                                        Clicked="HandleMoveItemUpClicked" />
                                          <Button Grid.Column="3"
                                                        Text="{Binding Source={x:Reference RootPage}, Path=MoveDownButtonText}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Padding="10,8"
                                                        Clicked="HandleMoveItemDownClicked" />
                                   </Grid>

                                   <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start" AlignItems="Center">
                                          <Button Text="{Binding Source={x:Reference RootPage}, Path=EditButtonText}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Margin="0,0,8,8"
                                                        Clicked="HandleRenameItemClicked" />
                                          <Button Text="{Binding Source={x:Reference RootPage}, Path=RemoveButtonText}"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        Margin="0,0,8,8"
                                                        Clicked="HandleRemoveItemClicked" />
                                   </FlexLayout>
                            </VerticalStackLayout>
                     </Border>
              </DataTemplate>
       </ContentPage.Resources>

       <Grid RowDefinitions="Auto,*">
              <Grid Grid.Row="0"
                       RowDefinitions="Auto,1"
                       BackgroundColor="#0A0A0A">
                     <Grid x:Name="TopBar"
                              ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="12"
                              Padding="16,12,16,12">
                            <Image x:Name="LogoImage"
                                      Source="favicon.png"
                                      HeightRequest="40"
                                      WidthRequest="40"
                                      Aspect="AspectFit"
                                      VerticalOptions="Center">
                                   <Image.GestureRecognizers>
                                          <TapGestureRecognizer Tapped="HandleHomeTapped" />
                                   </Image.GestureRecognizers>
                            </Image>

                            <HorizontalStackLayout Grid.Column="1"
                                                           Spacing="10"
                                                           VerticalOptions="Center">
                                   <Border x:Name="ShoppingListsButton"
                                                 BackgroundColor="#34D399"
                                                 Stroke="#34D399"
                                                 StrokeThickness="1"
                                                 HeightRequest="40"
                                                 WidthRequest="40"
                                                 Padding="0">
                                          <Border.StrokeShape>
                                                 <RoundRectangle CornerRadius="20" />
                                          </Border.StrokeShape>
                                          <Border.GestureRecognizers>
                                                 <TapGestureRecognizer Tapped="HandleHomeTapped" />
                                          </Border.GestureRecognizers>
                                          <Grid Padding="10,11"
                                                   RowDefinitions="Auto,Auto,Auto"
                                                   RowSpacing="4">
                                                 <BoxView HeightRequest="2" HorizontalOptions="Fill" CornerRadius="1" Color="#171717" />
                                                 <BoxView Grid.Row="1" HeightRequest="2" HorizontalOptions="Fill" CornerRadius="1" Color="#171717" />
                                                 <BoxView Grid.Row="2" HeightRequest="2" HorizontalOptions="Start" WidthRequest="10" CornerRadius="1" Color="#171717" />
                                          </Grid>
                                   </Border>

                                   <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                          <Label Text="Boodschap"
                                                    TextColor="#F5F5F5"
                                                    FontSize="18"
                                                    FontFamily="OpenSansSemibold" />
                                          <Label x:Name="HeaderContextLabel"
                                                    Style="{StaticResource BodyStyle}" />
                                   </VerticalStackLayout>
                            </HorizontalStackLayout>

                            <Button x:Name="SignOutButton"
                                          Grid.Column="2"
                                          Style="{StaticResource SecondaryButtonStyle}"
                                          Padding="14,10"
                                          Clicked="HandleSignOutClicked"
                                          VerticalOptions="Center" />
                     </Grid>

                     <BoxView Grid.Row="1" Color="#1AFFFFFF" />
              </Grid>

              <Grid Grid.Row="1">
                     <ScrollView>
                            <VerticalStackLayout Padding="16,24,16,32" Spacing="24">
                                   <Border x:Name="StatusBanner"
                                                 BackgroundColor="#102A22"
                                                 Stroke="#1E4F42"
                                                 StrokeThickness="1"
                                                 Padding="14"
                                                 IsVisible="False">
                                          <Border.StrokeShape>
                                                 <RoundRectangle CornerRadius="18" />
                                          </Border.StrokeShape>
                                          <Label x:Name="StatusLabel" TextColor="#D1FAE5" />
                                   </Border>

                                   <VerticalStackLayout x:Name="LoginView" Spacing="16" IsVisible="False">
                                          <Label x:Name="LoginEyebrowLabel" Style="{StaticResource EyebrowStyle}" />
                                          <Label x:Name="LoginTitleLabel" Style="{StaticResource PageHeadingStyle}" />
                                          <Label x:Name="LoginDescriptionLabel" Style="{StaticResource BodyStyle}" />

                                          <Border BackgroundColor="#111111"
                                                        Stroke="#202020"
                                                        StrokeThickness="1"
                                                        Padding="16">
                                                 <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="24" />
                                                 </Border.StrokeShape>
                                                 <VerticalStackLayout Spacing="14">
                                                        <VerticalStackLayout Spacing="2">
                                                               <Label x:Name="UsernameLabel" TextColor="#F5F5F5" FontFamily="OpenSansSemibold" />
                                                               <Entry x:Name="UsernameEntry" AutomationId="LoginUsernameEntry" Style="{StaticResource InputStyle}" />
                                                        </VerticalStackLayout>

                                                        <VerticalStackLayout Spacing="2">
                                                               <Label x:Name="PasswordLabel" TextColor="#F5F5F5" FontFamily="OpenSansSemibold" />
                                                               <Entry x:Name="PasswordEntry" AutomationId="LoginPasswordEntry" Style="{StaticResource InputStyle}" IsPassword="True" />
                                                        </VerticalStackLayout>

                                                        <Button x:Name="LoginButton"
                                                                      AutomationId="LoginButton"
                                                                      Style="{StaticResource PrimaryButtonStyle}"
                                                                      Clicked="HandleLoginClicked" />
                                                 </VerticalStackLayout>
                                          </Border>
                                   </VerticalStackLayout>

                                   <VerticalStackLayout x:Name="OverviewView" Spacing="20" IsVisible="False">
                                          <VerticalStackLayout Spacing="6">
                                                 <Label x:Name="OverviewEyebrowLabel" Style="{StaticResource EyebrowStyle}" />
                                                 <Label x:Name="OverviewHeadingLabel" Style="{StaticResource PageHeadingStyle}" />
                                                 <Label x:Name="OverviewDescriptionLabel" Style="{StaticResource BodyStyle}" />
                                          </VerticalStackLayout>

                                          <Button x:Name="CreateListButton"
                                                        AutomationId="CreateListButton"
                                                        Style="{StaticResource PrimaryButtonStyle}"
                                                        Clicked="HandleCreateListClicked" />

                                          <VerticalStackLayout x:Name="ActiveListsHost"
                                                        Spacing="12"
                                                        BindableLayout.ItemTemplate="{StaticResource ActiveListTemplate}" />
                                          <Label x:Name="ActiveEmptyLabel" Style="{StaticResource BodyStyle}" IsVisible="False" />

                                          <Label x:Name="ArchivedHeadingLabel" Style="{StaticResource SectionHeadingStyle}" />
                                          <VerticalStackLayout x:Name="ArchivedListsHost"
                                                        Spacing="12"
                                                        BindableLayout.ItemTemplate="{StaticResource ArchivedListTemplate}" />
                                          <Label x:Name="ArchivedEmptyLabel" Style="{StaticResource BodyStyle}" IsVisible="False" />
                                   </VerticalStackLayout>

                                   <VerticalStackLayout x:Name="DetailView" Spacing="18" IsVisible="False">
                                          <Button x:Name="BackButton"
                                                        AutomationId="BackToOverviewButton"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        HorizontalOptions="Start"
                                                        Clicked="HandleBackClicked" />

                                          <VerticalStackLayout Spacing="6">
                                                 <Label x:Name="DetailHeadingLabel" Style="{StaticResource PageHeadingStyle}" />
                                                 <Label x:Name="DetailDescriptionLabel" Style="{StaticResource BodyStyle}" />
                                                 <Label x:Name="DetailSummaryLabel" Style="{StaticResource EyebrowStyle}" />
                                          </VerticalStackLayout>

                                          <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start" AlignItems="Center">
                                                 <Button x:Name="EditCurrentListButton"
                                                               Style="{StaticResource SecondaryButtonStyle}"
                                                               Margin="0,0,8,8"
                                                               Clicked="HandleEditCurrentListClicked" />
                                                 <Button x:Name="ArchiveCurrentListButton"
                                                               Style="{StaticResource SecondaryButtonStyle}"
                                                               Margin="0,0,8,8"
                                                               Clicked="HandleArchiveCurrentListClicked" />
                                                 <Button x:Name="AddItemButton"
                                                               AutomationId="AddItemButton"
                                                               Style="{StaticResource PrimaryButtonStyle}"
                                                               Margin="0,0,8,8"
                                                               Clicked="HandleAddItemClicked" />
                                          </FlexLayout>

                                          <Label x:Name="ItemHintLabel" Style="{StaticResource BodyStyle}" />

                                          <VerticalStackLayout x:Name="CurrentItemsHost"
                                                        Spacing="12"
                                                        BindableLayout.ItemTemplate="{StaticResource ShoppingItemTemplate}" />
                                          <Label x:Name="CurrentItemsEmptyLabel" Style="{StaticResource BodyStyle}" IsVisible="False" />
                                   </VerticalStackLayout>
                            </VerticalStackLayout>
                     </ScrollView>

                     <Grid x:Name="LoadingOverlay"
                              BackgroundColor="#BF070708"
                              IsVisible="False"
                              InputTransparent="False">
                            <ActivityIndicator IsRunning="True"
                                                    Color="#34D399"
                                                    HeightRequest="48"
                                                    WidthRequest="48"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center" />
                     </Grid>
              </Grid>
       </Grid>

</ContentPage>
