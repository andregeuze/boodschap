@inject AppInitializationService AppInitialization
@inject IStringLocalizer<AppStrings> Localizer

@if (initializationError is not null)
{
	<main class="flex min-h-screen items-center justify-center bg-neutral-950 px-6 text-center text-neutral-100">
		<div class="max-w-sm space-y-4">
			<h1 class="text-2xl font-bold">@Localizer["Error.Title"]</h1>
			<p class="text-sm text-neutral-400">@Localizer["Error.Message"]</p>
			<button class="rounded-full bg-emerald-400 px-5 py-2.5 font-semibold text-neutral-950" @onclick="InitializeAsync">
				@Localizer["Reconnect.Retry"]
			</button>
		</div>
	</main>
}
else if (!initialized)
{
	<main class="flex min-h-screen items-center justify-center bg-neutral-950 text-emerald-400">
		<span class="h-10 w-10 animate-spin rounded-full border-4 border-white/10 border-t-emerald-400" aria-label="@Localizer["Account.Loading"]"></span>
	</main>
}
else
{
	<CascadingAuthenticationState>
		<MobileRoutes />
	</CascadingAuthenticationState>
}

@code {
	private bool initialized;
	private Exception? initializationError;

	protected override Task OnInitializedAsync() => InitializeAsync();

	private async Task InitializeAsync()
	{
		initializationError = null;
		try
		{
			await AppInitialization.InitializeAsync();
			initialized = true;
		}
		catch (Exception exception)
		{
			initializationError = exception;
		}
	}
}